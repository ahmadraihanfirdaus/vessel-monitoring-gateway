{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vessel-gateway:telemetry:1.0",
  "title": "Vessel Gateway Telemetry Development Contract v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "firmware_version",
    "boot_id",
    "sequence",
    "uptime_ms",
    "source_mode",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "firmware_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_mode": {
      "enum": [
        "simulation",
        "bench_test",
        "physical"
      ]
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._:-]+$",
        "maxLength": 32
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "quality"
        ],
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "quality": {
            "enum": [
              "valid",
              "invalid",
              "missing",
              "stale",
              "unknown"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "quality": {
                  "const": "valid"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quality": {
                  "enum": [
                    "invalid",
                    "missing",
                    "unknown"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
